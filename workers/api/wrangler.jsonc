{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "speak-coach-api",
  "main": "src/index.ts",
  "account_id": "3ee25fc8fe5e195ebf2e54da536e2d62",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speak-coach",
      "database_id": "efa74e81-0ccb-43a2-8384-5e6fdc4951f3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VOICE",
      "bucket_name": "speak-coach-voice"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COACH_ROOM",
        "class_name": "CoachRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-coach-room-do",
      "new_sqlite_classes": ["CoachRoomDO"]
    }
  ],
  // NEVER put secrets in this file (no JWT_SECRET, API keys, passwords).
  // Production secrets live only in Cloudflare (encrypted), set with:
  //   npx wrangler secret put JWT_SECRET
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put EMAIL_FROM
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
  //   npx wrangler secret put AUTH_DEV_EXPOSE_OTP
  // Local secrets: workers/api/.dev.vars  (gitignored — copy from .dev.vars.example)
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
