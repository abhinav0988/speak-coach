{
  "info": {
    "name": "Speak Coach API",
    "description": "Complete API collection for Speak Coach (email auth).\n\n**Setup:**\n1. Import environment `Speak-Coach-Local.postman_environment.json`\n2. Set `baseUrl` = http://localhost:8787\n3. Ensure `workers/api/.dev.vars` has `JWT_SECRET` and `AUTH_DEV_EXPOSE_OTP=true`\n4. Run **00 — Auth → Login** (or Register + Verify Email) before protected routes\n\n**Auth:** HttpOnly cookies (`sc_access`, `sc_refresh`) + `X-CSRF-Token` header from `{{csrfToken}}`. Postman stores cookies automatically. Optional: `Authorization: Bearer` with a JWT access token.\n\n**Multipart:** Voice/shadowing/roleplay/paragraph read need an audio file — pick any .webm/.wav in form-data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "testEmail",
      "value": "postman@example.com"
    },
    {
      "key": "testPassword",
      "value": "PostmanTest1!"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 — Auth (run first)",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.devOtp) pm.collectionVariables.set('otp', j.devOtp);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}"
            },
            "description": "Public. With AUTH_DEV_EXPOSE_OTP=true, saves devOtp to {{otp}}."
          }
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrfToken) pm.collectionVariables.set('csrfToken', j.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/verify-email",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "description": "Public. Sets session cookies + csrfToken on success."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrfToken) pm.collectionVariables.set('csrfToken', j.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "description": "Public. Sets session cookies + csrfToken. Use after register/verify or for returning users."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Refresh Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrfToken) pm.collectionVariables.set('csrfToken', j.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Requires CSRF header (collection pre-request script)."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/reset-password",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"password\": \"NewPostman1!\",\n  \"confirmPassword\": \"NewPostman1!\"\n}"
            }
          }
        },
        {
          "name": "List Device Sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/sessions"
          }
        },
        {
          "name": "WebSocket Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/ws-token",
            "description": "Returns short-lived JWT for ?ws_token= on /api/coach/ws"
          }
        }
      ]
    },
